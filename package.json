{
  "name": "redmine-module-toggle-gui",
  "version": "0.4.0",
  "description": "Redmine 全プロジェクトのモジュールを一括ON/OFFするGUI (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "author": "Agileware Inc.",
  "license": "MIT",
  "dependencies": {
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "jp.agileware.redmine-module-toggle",
    "productName": "RedmineModuleToggle",
    "files": [
      "main.js",
      "preload.js",
      "redmine.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
