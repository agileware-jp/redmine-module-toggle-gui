{
  "name": "redmine-module-toggle-gui",
  "version": "0.4.3",
  "description": "Redmine 全プロジェクトのモジュールを一括ON/OFFするGUI (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Agileware Inc.",
  "license": "MIT",
  "dependencies": {
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "jp.agileware.redmine-module-toggle",
    "productName": "Redmine Module Toggler",
    "files": [
      "main.js",
      "preload.js",
      "redmine.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    }
  }
}
